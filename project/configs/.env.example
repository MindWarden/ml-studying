# Шаблон переменных окружения. Скопируйте в .env и заполните при необходимости.
# Реальный .env в репозиторий НЕ коммитится (см. .gitignore).

# Сервис
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Пути к артефактам (относительно корня project/)
MODEL_PATH=artifacts/model.pkl

# Данные
DATA_PATH=data/raw/telco_churn.csv

# Порог классификации (вероятность >= threshold => Churn=Yes)
CHURN_THRESHOLD=0.5
